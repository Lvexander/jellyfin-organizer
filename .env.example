# Destination for optionally moving finished folders.
FINISHED_FOLDER_PATH=

# Directories to search recursively when looking for the
# folder name entered by the user. Separate multiple paths
# with commas. The script searches these locations for an
# exact folder-name match.
# Example: SEARCH_PATHS=~/shared,~/jellyfin
SEARCH_PATHS=

# MyAnimeList API client ID (https://myanimelist.net/apiconfig).
MAL_CLIENT_ID=

# TMDB API key (https://www.themoviedb.org/settings/api).
TMDB_API_KEY=
